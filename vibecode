
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gen Yus App v2.6</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap');
        
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
        }

        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }

        .active-tab {
            background-color: #eef2ff;
            color: var(--primary);
            font-weight: 800;
        }

        .btn-press:active {
            transform: scale(0.95);
        }

        .custom-shadow {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
        }

        /* Perbaikan untuk scrollbar mobile */
        .hide-scroll::-webkit-scrollbar { display: none; }
        
        .modal-animate {
            animation: slideUp 0.3s ease-out;
        }

        @keyframes slideUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Loading Spinner */
        .loader {
            border: 3px solid #f3f3f3;
            border-top: 3px solid var(--primary);
            border-radius: 50%;
            width: 20px;
            height: 20px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-[#FDFDFD] text-slate-900">

    <!-- SCREEN 1: LANDING -->
    <section id="landingScreen" class="fixed inset-0 z-[100] bg-white flex flex-col items-center justify-center p-8 transition-all duration-500">
        <div class="w-24 h-24 bg-indigo-600 rounded-[2.5rem] flex items-center justify-center text-white mb-10 shadow-2xl shadow-indigo-200">
            <i class="fa-solid fa-bolt-lightning text-4xl"></i>
        </div>
        <h1 class="text-4xl font-black tracking-tighter text-center leading-none mb-4">
            GEN YUS<br><span class="text-indigo-600">PRODUCTIVE</span>
        </h1>
        <p class="text-slate-400 text-center max-w-xs mb-12 font-medium leading-relaxed">
            Versi 2.6: Perbaikan sistem navigasi dan optimasi performa ketukan.
        </p>
        <button onclick="goToDashboard()" class="w-full max-w-xs bg-indigo-600 text-white py-5 rounded-2xl font-bold tracking-widest uppercase text-sm shadow-xl shadow-indigo-100 btn-press">
            Buka Aplikasi <i class="fa-solid fa-chevron-right ml-2"></i>
        </button>
    </section>

    <!-- SCREEN 2: DASHBOARD -->
    <div id="mainApp" class="hidden min-h-screen flex flex-col md:flex-row opacity-0 transition-opacity duration-500">
        
        <!-- Sidebar / Top Bar Mobile -->
        <aside class="w-full md:w-72 bg-white border-r border-slate-100 p-6 flex flex-col sticky top-0 z-40">
            <div class="flex items-center justify-between mb-10 md:mb-12">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-indigo-600 rounded-xl flex items-center justify-center text-white text-sm shadow-lg shadow-indigo-100">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <span class="font-black text-lg tracking-tighter uppercase">Gen Yus</span>
                </div>
                <div id="syncStatus" class="text-[10px] font-black text-green-500 uppercase flex items-center gap-1">
                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></div> Online
                </div>
            </div>

            <nav class="flex md:flex-col gap-2 overflow-x-auto hide-scroll pb-2 md:pb-0">
                <button onclick="showTab('tugas')" id="nav-tugas" class="flex-1 md:flex-none flex items-center gap-4 px-6 py-4 rounded-2xl active-tab text-xs font-black uppercase tracking-widest transition-all btn-press whitespace-nowrap">
                    <i class="fa-solid fa-layer-group"></i> Agenda
                </button>
                <button onclick="showTab('stats')" id="nav-stats" class="flex-1 md:flex-none flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 text-xs font-black uppercase tracking-widest transition-all btn-press whitespace-nowrap">
                    <i class="fa-solid fa-chart-line"></i> Statistik
                </button>
            </nav>

            <button onclick="location.reload()" class="mt-auto hidden md:flex items-center gap-3 p-4 text-slate-300 hover:text-red-500 font-bold text-xs uppercase tracking-widest transition-all">
                <i class="fa-solid fa-arrow-right-from-bracket"></i> Keluar
            </button>
        </aside>

        <!-- Main Area -->
        <main class="flex-1 p-6 md:p-12 pb-32">
            
            <!-- Tab Agenda -->
            <section id="tab-tugas" class="max-w-3xl mx-auto">
                <div class="mb-10">
                    <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">Halo, Yus 👋</h2>
                    <p id="summaryText" class="text-slate-400 font-bold text-[10px] uppercase tracking-widest mt-1">Mengambil data terbaru...</p>
                </div>

                <div id="taskList" class="grid grid-cols-1 gap-4">
                    <!-- Data dari Firebase -->
                    <div class="flex flex-col items-center justify-center py-20 text-slate-300">
                        <div class="loader mb-4"></div>
                        <p class="text-[10px] font-black uppercase tracking-widest">Menyinkronkan...</p>
                    </div>
                </div>
            </section>

            <!-- Tab Stats -->
            <section id="tab-stats" class="hidden max-w-3xl mx-auto animate-in fade-in">
                <div class="bg-indigo-600 rounded-[2.5rem] p-10 text-white shadow-2xl shadow-indigo-100 mb-8 relative overflow-hidden">
                    <div class="relative z-10">
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] opacity-60 mb-2">Total Pencapaian</p>
                        <h2 class="text-5xl font-black mb-6" id="statCompleted">0</h2>
                        <p class="text-sm font-medium opacity-80 leading-relaxed">Teruslah melangkah! Setiap tugas yang selesai membawamu lebih dekat ke tujuan.</p>
                    </div>
                    <i class="fa-solid fa-award absolute -right-6 -bottom-6 text-9xl opacity-10 rotate-12"></i>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 text-center">
                        <p class="text-2xl font-black text-slate-900" id="statTotal">0</p>
                        <p class="text-[9px] font-black uppercase text-slate-400 tracking-widest mt-1">Total Agenda</p>
                    </div>
                    <div class="bg-white p-6 rounded-3xl border border-slate-100 text-center">
                        <p class="text-2xl font-black text-amber-500" id="statImportant">0</p>
                        <p class="text-[9px] font-black uppercase text-slate-400 tracking-widest mt-1">Prioritas</p>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- FLOAT BUTTON -->
    <button onclick="toggleModal(true)" id="fab" class="hidden fixed bottom-8 right-8 w-16 h-16 bg-indigo-600 text-white rounded-2xl shadow-2xl shadow-indigo-300 items-center justify-center text-2xl transition-all btn-press z-50">
        <i class="fa-solid fa-plus"></i>
    </button>

    <!-- MODAL ADD -->
    <div id="modalContainer" class="hidden fixed inset-0 z-[100] bg-slate-900/40 backdrop-blur-sm flex items-end md:items-center justify-center p-0 md:p-6">
        <div class="bg-white w-full max-w-xl rounded-t-[2.5rem] md:rounded-[2.5rem] p-8 md:p-12 modal-animate custom-shadow">
            <div class="flex justify-between items-center mb-8">
                <h3 class="text-xl font-black uppercase tracking-tighter">Tambah Agenda</h3>
                <button onclick="toggleModal(false)" class="w-10 h-10 bg-slate-50 rounded-xl text-slate-400 flex items-center justify-center"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="space-y-6">
                <div>
                    <label class="text-[10px] font-black uppercase text-slate-400 tracking-widest mb-2 block">Judul Tugas</label>
                    <input type="text" id="inpTitle" placeholder="Belajar Coding..." class="w-full bg-slate-50 border-none rounded-2xl p-5 font-bold focus:ring-2 focus:ring-indigo-100 outline-none">
                </div>
                
                <div>
                    <label class="text-[10px] font-black uppercase text-slate-400 tracking-widest mb-2 block">Catatan (Opsional)</label>
                    <textarea id="inpNote" placeholder="Detail tugas..." class="w-full bg-slate-50 border-none rounded-2xl p-5 font-medium text-sm focus:ring-2 focus:ring-indigo-100 outline-none min-h-[100px] resize-none"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 tracking-widest mb-2 block">Waktu Deadline</label>
                        <input type="datetime-local" id="inpDate" class="w-full bg-slate-50 border-none rounded-xl p-4 text-xs font-bold focus:ring-2 focus:ring-indigo-100 outline-none">
                    </div>
                    <div>
                        <label class="text-[10px] font-black uppercase text-slate-400 tracking-widest mb-2 block">Prioritas</label>
                        <button onclick="setPriority()" id="priorityBtn" class="w-full bg-slate-50 p-4 rounded-xl flex items-center justify-between border-2 border-transparent transition-all">
                            <span class="text-xs font-bold text-slate-500">Penting?</span>
                            <i class="fa-solid fa-star text-slate-200"></i>
                        </button>
                    </div>
                </div>

                <button onclick="handleSave()" id="btnSave" class="w-full bg-indigo-600 text-white py-5 rounded-2xl font-black uppercase tracking-widest text-xs shadow-xl shadow-indigo-100 btn-press mt-4">
                    Simpan Agenda
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";
        import { getFirestore, collection, addDoc, onSnapshot, updateDoc, doc, deleteDoc, query, orderBy } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.0.2/firebase-auth.js";

        // Konfigurasi
        const firebaseConfig = JSON.parse(window.atob('__firebase_config_base64__'.replace('__firebase_config_base64__', btoa(JSON.stringify(JSON.parse(__firebase_config))))));
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'gen-yus-v2-6';

        let localTasks = [];
        let currentImportant = false;

        // Navigasi
        window.goToDashboard = () => {
            document.getElementById('landingScreen').classList.add('opacity-0', 'pointer-events-none', 'scale-110');
            const main = document.getElementById('mainApp');
            main.classList.remove('hidden');
            setTimeout(() => {
                main.classList.add('opacity-100');
                document.getElementById('fab').classList.remove('hidden');
                document.getElementById('fab').classList.add('flex');
            }, 100);
        };

        window.showTab = (tab) => {
            const tabs = ['tugas', 'stats'];
            tabs.forEach(t => {
                document.getElementById(`tab-${t}`).classList.toggle('hidden', t !== tab);
                const btn = document.getElementById(`nav-${t}`);
                if (t === tab) {
                    btn.classList.add('active-tab');
                    btn.classList.remove('text-slate-400');
                } else {
                    btn.classList.remove('active-tab');
                    btn.classList.add('text-slate-400');
                }
            });
            if(tab === 'stats') renderStats();
        };

        window.toggleModal = (show) => {
            document.getElementById('modalContainer').classList.toggle('hidden', !show);
        };

        window.setPriority = () => {
            currentImportant = !currentImportant;
            const btn = document.getElementById('priorityBtn');
            const star = btn.querySelector('i');
            btn.classList.toggle('border-indigo-600', currentImportant);
            btn.classList.toggle('bg-indigo-50', currentImportant);
            star.classList.toggle('text-amber-500', currentImportant);
            star.classList.toggle('text-slate-200', !currentImportant);
        };

        // Firebase Ops
        const initData = async () => {
            try {
                const cred = await signInAnonymously(auth);
                const q = query(collection(db, 'artifacts', appId, 'users', cred.user.uid, 'tasks'), orderBy('createdAt', 'desc'));
                
                onSnapshot(q, (snapshot) => {
                    localTasks = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
                    renderList();
                }, (err) => {
                    console.error("Firestore error:", err);
                    document.getElementById('syncStatus').innerHTML = '<span class="text-red-500">Error Sync</span>';
                });
            } catch (err) {
                console.error("Auth error:", err);
            }
        };

        window.handleSave = async () => {
            const title = document.getElementById('inpTitle').value;
            const note = document.getElementById('inpNote').value;
            const deadline = document.getElementById('inpDate').value;
            const btnSave = document.getElementById('btnSave');

            if (!title) return alert("Judul tidak boleh kosong!");

            btnSave.disabled = true;
            btnSave.innerHTML = '<div class="loader mx-auto"></div>';

            try {
                await addDoc(collection(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks'), {
                    text: title,
                    note: note,
                    deadline: deadline,
                    important: currentImportant,
                    completed: false,
                    createdAt: new Date().toISOString()
                });
                
                // Reset
                document.getElementById('inpTitle').value = '';
                document.getElementById('inpNote').value = '';
                document.getElementById('inpDate').value = '';
                if(currentImportant) setPriority();
                toggleModal(false);
            } catch (e) {
                alert("Gagal menyimpan!");
            } finally {
                btnSave.disabled = false;
                btnSave.innerText = "Simpan Agenda";
            }
        };

        window.toggleComplete = async (id, current) => {
            await updateDoc(doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks', id), {
                completed: !current
            });
        };

        window.handleDelete = async (id) => {
            if(confirm("Hapus agenda ini?")) {
                await deleteDoc(doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks', id));
            }
        };

        function renderList() {
            const list = document.getElementById('taskList');
            const summary = document.getElementById('summaryText');
            list.innerHTML = '';

            const pendingCount = localTasks.filter(t => !t.completed).length;
            summary.innerText = pendingCount > 0 ? `${pendingCount} Agenda Menunggu` : 'Semua Beres! 🎉';

            if (localTasks.length === 0) {
                list.innerHTML = `
                    <div class="text-center py-20 opacity-30">
                        <i class="fa-solid fa-face-smile text-6xl mb-4"></i>
                        <p class="font-black uppercase text-xs tracking-widest">Belum ada tugas</p>
                    </div>
                `;
                return;
            }

            localTasks.forEach(t => {
                const isOverdue = t.deadline && new Date(t.deadline) < new Date() && !t.completed;
                const card = document.createElement('div');
                card.className = `bg-white p-6 rounded-[2rem] border-2 transition-all flex items-start gap-4 ${t.completed ? 'border-transparent opacity-60' : 'border-slate-50'}`;
                
                card.innerHTML = `
                    <button onclick="toggleComplete('${t.id}', ${t.completed})" class="mt-1 btn-press">
                        <i class="${t.completed ? 'fa-solid fa-circle-check text-green-500' : 'fa-regular fa-circle text-slate-200'} text-2xl"></i>
                    </button>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-lg ${t.completed ? 'line-through text-slate-300' : 'text-slate-800'} truncate">${t.text}</h3>
                            ${t.important ? '<i class="fa-solid fa-star text-amber-400 text-[10px]"></i>' : ''}
                        </div>
                        ${t.note ? `<p class="text-xs text-slate-400 mt-1 line-clamp-2">${t.note}</p>` : ''}
                        ${t.deadline ? `
                            <div class="mt-3 flex items-center gap-2 text-[10px] font-black uppercase tracking-widest ${isOverdue ? 'text-red-500' : 'text-slate-300'}">
                                <i class="fa-solid fa-clock"></i> ${new Date(t.deadline).toLocaleString('id-ID', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'})}
                            </div>
                        ` : ''}
                    </div>
                    <button onclick="handleDelete('${t.id}')" class="p-2 text-slate-100 hover:text-red-400 transition-colors">
                        <i class="fa-solid fa-trash-can text-sm"></i>
                    </button>
                `;
                list.appendChild(card);
            });
        }

        function renderStats() {
            document.getElementById('statTotal').innerText = localTasks.length;
            document.getElementById('statCompleted').innerText = localTasks.filter(t => t.completed).length;
            document.getElementById('statImportant').innerText = localTasks.filter(t => t.important).length;
        }

        // Run
        initData();
    </script>
</body>
</html>

```
