```html
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gen Yus App v2.5</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; transition: all 0.3s ease; }
        .glass { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); }
        .card-shadow { box-shadow: 0 10px 30px -5px rgba(79, 70, 229, 0.1); }
        .pulse-orange { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
        .hide-scroll::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-[#F9FAFB] text-slate-800">

    <!-- LANDING PAGE -->
    <div id="landingPage" class="fixed inset-0 z-[100] bg-white flex flex-col items-center justify-center p-6 text-center">
        <div class="w-20 h-20 bg-indigo-600 rounded-[2rem] flex items-center justify-center text-white mb-8 shadow-2xl shadow-indigo-200">
            <i class="fa-solid fa-bolt text-3xl"></i>
        </div>
        <h1 class="text-5xl font-black tracking-tighter mb-4 text-slate-900 leading-tight">GEN YUS<br><span class="text-indigo-600 font-extrabold uppercase">App v2.5</span></h1>
        <p class="text-slate-400 font-medium mb-10 max-w-sm">Kelola agenda, catatan, dan deadline dengan performa super kilat & desain premium.</p>
        <button onclick="enterApp()" class="bg-indigo-600 text-white px-12 py-5 rounded-[2rem] font-black tracking-widest hover:scale-105 active:scale-95 transition-all shadow-xl shadow-indigo-200 uppercase text-sm">
            Mulai Sekarang <i class="fa-solid fa-arrow-right ml-2"></i>
        </button>
        <p class="mt-20 text-[10px] font-bold text-slate-300 uppercase tracking-[0.3em]">Built for Yus Productivity</p>
    </div>

    <!-- MAIN DASHBOARD -->
    <div id="appUI" class="hidden min-h-screen flex flex-col md:flex-row">
        
        <!-- Sidebar -->
        <aside class="w-full md:w-80 bg-white border-r border-slate-100 p-8 flex flex-col">
            <div class="flex items-center gap-3 mb-12">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white"><i class="fa-solid fa-bolt"></i></div>
                <h1 class="text-xl font-black tracking-tighter uppercase">Gen Yus</h1>
            </div>

            <nav class="space-y-2 flex-1">
                <button onclick="switchTab('tugas')" id="btn-tugas" class="w-full flex items-center gap-4 px-6 py-4 rounded-2xl bg-indigo-50 text-indigo-600 font-black text-xs uppercase tracking-widest transition-all">
                    <i class="fa-solid fa-list-check"></i> Agenda Utama
                </button>
                <button onclick="switchTab('stats')" id="btn-stats" class="w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 font-black text-xs uppercase tracking-widest transition-all">
                    <i class="fa-solid fa-chart-pie"></i> Statistik
                </button>
            </nav>

            <button onclick="location.reload()" class="mt-auto p-4 text-slate-300 hover:text-red-500 font-bold text-xs uppercase tracking-widest flex items-center gap-3">
                <i class="fa-solid fa-power-off"></i> Keluar
            </button>
        </aside>

        <!-- Content -->
        <main class="flex-1 p-6 md:p-14 overflow-y-auto">
            <div id="tab-tugas" class="max-w-3xl mx-auto">
                <header class="flex justify-between items-end mb-12">
                    <div>
                        <h2 class="text-4xl font-black text-slate-900 tracking-tight">Halo, Yus!</h2>
                        <p id="taskCountLabel" class="text-slate-400 font-bold text-[10px] uppercase tracking-widest mt-1">Memuat data...</p>
                    </div>
                </header>

                <!-- Filter -->
                <div class="flex gap-2 mb-10 overflow-x-auto hide-scroll pb-2">
                    <button onclick="setFilter('all')" class="px-6 py-3 rounded-full bg-slate-900 text-white font-black text-[10px] uppercase tracking-widest shadow-lg">Semua</button>
                    <button onclick="setFilter('pending')" class="px-6 py-3 rounded-full bg-white text-slate-400 font-black text-[10px] uppercase tracking-widest border border-slate-100">Berjalan</button>
                </button>
                </div>

                <!-- List Tugas -->
                <div id="taskList" class="space-y-4">
                    <!-- Dinamis via JS -->
                </div>
            </div>

            <div id="tab-stats" class="hidden max-w-3xl mx-auto text-center py-20">
                <i class="fa-solid fa-trophy text-6xl text-amber-400 mb-6"></i>
                <h2 class="text-3xl font-black mb-2">Pencapaian Kamu</h2>
                <p id="statsDetail" class="text-slate-400 font-medium mb-10">Kamu sudah menyelesaikan 0 tugas.</p>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-8 rounded-[2rem] card-shadow">
                        <p id="totalTasks" class="text-3xl font-black text-indigo-600">0</p>
                        <p class="text-[10px] font-black uppercase text-slate-300">Total Tugas</p>
                    </div>
                    <div class="bg-white p-8 rounded-[2rem] card-shadow">
                        <p id="doneTasks" class="text-3xl font-black text-green-500">0</p>
                        <p class="text-[10px] font-black uppercase text-slate-300">Selesai</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- FAB -->
    <button onclick="openModal()" class="fixed bottom-10 right-10 w-16 h-16 bg-indigo-600 text-white rounded-2xl shadow-2xl shadow-indigo-200 flex items-center justify-center text-2xl hover:scale-110 active:scale-95 transition-all z-50">
        <i class="fa-solid fa-plus"></i>
    </button>

    <!-- Modal Tambah -->
    <div id="modalAdd" class="hidden fixed inset-0 z-[200] bg-slate-900/60 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-[2.5rem] p-10 shadow-2xl">
            <div class="flex justify-between items-center mb-8">
                <h3 class="text-xl font-black uppercase tracking-tighter">Agenda Baru</h3>
                <button onclick="closeModal()" class="text-slate-300 hover:text-slate-600"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="space-y-6">
                <input type="text" id="taskTitle" placeholder="Nama Agenda..." class="w-full text-2xl font-black border-none focus:ring-0 p-0 placeholder:text-slate-100">
                <textarea id="taskNote" placeholder="Catatan tambahan (opsional)..." class="w-full bg-slate-50 border-none rounded-2xl p-4 text-sm font-medium focus:ring-2 focus:ring-indigo-100 min-h-[100px]"></textarea>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-slate-50 p-4 rounded-xl flex flex-col">
                        <label class="text-[9px] font-black uppercase text-slate-400 mb-1">Deadline</label>
                        <input type="datetime-local" id="taskDeadline" class="bg-transparent border-none p-0 text-xs font-bold focus:ring-0">
                    </div>
                    <button onclick="toggleImportant()" id="btnImportant" class="bg-slate-50 p-4 rounded-xl flex items-center justify-between border-2 border-transparent">
                        <span class="text-[9px] font-black uppercase text-slate-400">Prioritas</span>
                        <i class="fa-solid fa-star text-slate-200"></i>
                    </button>
                </div>
                <button onclick="saveTask()" class="w-full bg-indigo-600 text-white py-5 rounded-2xl font-black uppercase tracking-widest text-xs shadow-xl shadow-indigo-100 hover:bg-indigo-700 transition-all">
                    Simpan Agenda
                </button>
            </div>
        </div>
    </div>

    <!-- Firebase SDKs -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getFirestore, collection, addDoc, onSnapshot, updateDoc, doc, deleteDoc, query, orderBy } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

        const firebaseConfig = JSON.parse('__firebase_config');
        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);
        const appId = '__app_id' || 'gen-yus-v2-5';

        let tasks = [];
        let filterStatus = 'all';
        let isImportant = false;

        // UI Functions
        window.enterApp = () => {
            document.getElementById('landingPage').classList.add('opacity-0', 'pointer-events-none');
            document.getElementById('appUI').classList.remove('hidden');
        };

        window.switchTab = (tab) => {
            document.getElementById('tab-tugas').classList.toggle('hidden', tab !== 'tugas');
            document.getElementById('tab-stats').classList.toggle('hidden', tab !== 'stats');
            document.getElementById('btn-tugas').className = tab === 'tugas' ? 'w-full flex items-center gap-4 px-6 py-4 rounded-2xl bg-indigo-50 text-indigo-600 font-black text-xs uppercase tracking-widest transition-all' : 'w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 font-black text-xs uppercase tracking-widest transition-all';
            document.getElementById('btn-stats').className = tab === 'stats' ? 'w-full flex items-center gap-4 px-6 py-4 rounded-2xl bg-indigo-50 text-indigo-600 font-black text-xs uppercase tracking-widest transition-all' : 'w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 font-black text-xs uppercase tracking-widest transition-all';
            if(tab === 'stats') updateStats();
        };

        window.openModal = () => document.getElementById('modalAdd').classList.remove('hidden');
        window.closeModal = () => document.getElementById('modalAdd').classList.add('hidden');
        
        window.toggleImportant = () => {
            isImportant = !isImportant;
            const btn = document.getElementById('btnImportant');
            btn.classList.toggle('border-indigo-600', isImportant);
            btn.querySelector('i').classList.toggle('text-amber-400', isImportant);
            btn.querySelector('i').classList.toggle('text-slate-200', !isImportant);
        };

        // Auth & Data
        signInAnonymously(auth).then(() => {
            const userId = auth.currentUser.uid;
            const q = query(collection(db, 'artifacts', appId, 'users', userId, 'tasks'), orderBy('createdAt', 'desc'));
            
            onSnapshot(q, (snapshot) => {
                tasks = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                renderTasks();
            });
        });

        window.saveTask = async () => {
            const title = document.getElementById('taskTitle').value;
            const note = document.getElementById('taskNote').value;
            const deadline = document.getElementById('taskDeadline').value;
            
            if(!title) return;

            await addDoc(collection(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks'), {
                text: title,
                note: note,
                deadline: deadline,
                important: isImportant,
                completed: false,
                createdAt: new Date().toISOString()
            });

            document.getElementById('taskTitle').value = '';
            document.getElementById('taskNote').value = '';
            document.getElementById('taskDeadline').value = '';
            isImportant = false;
            window.toggleImportant();
            closeModal();
        };

        window.toggleTask = async (id, status) => {
            await updateDoc(doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks', id), {
                completed: !status
            });
        };

        window.deleteTask = async (id) => {
            await deleteDoc(doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'tasks', id));
        };

        window.setFilter = (f) => {
            filterStatus = f;
            renderTasks();
        };

        function renderTasks() {
            const list = document.getElementById('taskList');
            list.innerHTML = '';
            
            const filtered = tasks.filter(t => {
                if(filterStatus === 'pending') return !t.completed;
                return true;
            });

            document.getElementById('taskCountLabel').innerText = `${tasks.filter(t => !t.completed).length} Agenda Menunggu`;

            filtered.forEach(task => {
                const isOverdue = task.deadline && new Date(task.deadline) < new Date() && !task.completed;
                const deadlineStr = task.deadline ? new Date(task.deadline).toLocaleString('id-ID', {day:'numeric', month:'short', hour:'2-digit', minute:'2-digit'}) : '';
                
                const div = document.createElement('div');
                div.className = `group bg-white p-6 rounded-[1.8rem] card-shadow flex items-start gap-4 transition-all border-2 ${task.completed ? 'opacity-50 border-transparent' : isOverdue ? 'border-red-100 bg-red-50/20' : 'border-transparent'}`;
                
                div.innerHTML = `
                    <button onclick="toggleTask('${task.id}', ${task.completed})" class="mt-1 transition-transform active:scale-75">
                        <i class="${task.completed ? 'fa-solid fa-circle-check text-green-500' : 'fa-regular fa-circle text-slate-200'} text-2xl"></i>
                    </button>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-lg ${task.completed ? 'line-through text-slate-300' : 'text-slate-800'} truncate">${task.text}</h3>
                            ${task.important ? '<span class="text-[8px] font-black bg-amber-100 text-amber-600 px-2 py-0.5 rounded-full uppercase">Penting</span>' : ''}
                        </div>
                        ${task.note ? `<p class="text-xs text-slate-400 mt-1 italic leading-relaxed">"${task.note}"</p>` : ''}
                        ${task.deadline ? `
                            <div class="flex items-center gap-2 mt-3 text-[10px] font-black uppercase tracking-widest ${isOverdue ? 'text-red-500 animate-pulse' : 'text-slate-300'}">
                                <i class="fa-solid fa-clock"></i> ${deadlineStr}
                            </div>
                        ` : ''}
                    </div>
                    <button onclick="deleteTask('${task.id}')" class="opacity-0 group-hover:opacity-100 p-2 text-slate-200 hover:text-red-500 transition-all">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                `;
                list.appendChild(div);
            });
        }

        function updateStats() {
            const done = tasks.filter(t => t.completed).length;
            document.getElementById('totalTasks').innerText = tasks.length;
            document.getElementById('doneTasks').innerText = done;
            document.getElementById('statsDetail').innerText = `Kamu sudah menyelesaikan ${done} tugas dari total ${tasks.length} agenda.`;
        }
    </script>
</body>
</html>

```
